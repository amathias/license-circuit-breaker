# License Circuit Breaker -- environment contract
#
# Copy to .env and fill in. .env is gitignored and must never be committed.
# Variable NAMES are the portfolio-wide shared contract owned by the coordinator
# (../COORDINATOR_PLAN.md). Do not rename them from this project chat.

# --- Project identity. Coordinator-assigned; do not change unilaterally. -----
PROJECT_SLUG=license-circuit-breaker
APP_ENV=local
APP_HOST=127.0.0.1
APP_PORT=8102
APP_PUBLIC_URL=

# Where SQLite, manifests, and disposable demo artifacts live.
# Deployed value is /var/lib/datahub-hackathon/license-circuit-breaker
# Local development should point this somewhere writable, e.g. .state
APP_STATE_DIR=.state

# --- DataHub connection. Values supplied by the coordinator. -----------------
# GMS must never be exposed directly to the public internet; reach it over an
# AWS Systems Manager port-forwarding session so this stays a localhost URL even when DataHub is remote.
DATAHUB_GMS_URL=http://localhost:8080
DATAHUB_MCP_URL=http://localhost:8000/mcp

# Personal access token. Secret -- never commit a real value.
# The shared contract names this DATAHUB_TOKEN; mcp-server-datahub reads
# DATAHUB_GMS_TOKEN, and app.config maps between them at launch.
DATAHUB_TOKEN=

# --- Namespace allocation. Coordinator registry; changing these risks -------
# --- writing into another submission's entities. ----------------------------
DATAHUB_DOMAIN=Demo / License Circuit Breaker
DATAHUB_PROJECT_TAG=project-license-circuit-breaker
DATAHUB_URN_PREFIX=license.

# --- Demo fixtures. Disposable; reset recreates them. -----------------------
DEMO_FIXTURE_ROOT=demo/fixtures/license-circuit-breaker

